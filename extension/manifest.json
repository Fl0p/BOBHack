{
  "manifest_version": 3,
  "name": "BOOBS",
  "version": "0.1.0",
  "description": "Back Office Operations Bots Solution",
  "options_page": "options.html",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Dify Autofill",
    "default_icon": {
      "16": "src/common/Untitled-1.png",
      "32": "src/common/Untitled-1.png",
      "48": "src/common/Untitled-1.png",
      "128": "src/common/Untitled-1.png"
    }
  },
  "icons": {
    "16": "src/common/Untitled-1.png",
    "32": "src/common/Untitled-1.png",
    "48": "src/common/Untitled-1.png",
    "128": "src/common/Untitled-1.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://your-dify-endpoint.example.com/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background/index.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/runtime.js",
        "content/domExclusionRegistry.js",
        "content/domExclusionDefaults.js",
        "content/labelResolver.js",
        "content/cssPathBuilder.js",
        "content/domSnapshotCollector.js",
        "content/elementValueSetter.js",
        "sites/olx/elementValueEnhancer.js",
        "content/fieldValueApplier.js",
        "sites/olx/prefillService.js",
        "sites/allegrolokalnie/prefillService.js",
        "content/messageRouter.js",
        "contentScript.js"
      ],
      "run_at": "document_idle"
    }
  ]
}

