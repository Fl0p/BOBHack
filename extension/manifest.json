{
  "manifest_version": 3,
  "name": "BOOBS",
  "version": "0.1.0",
  "description": "Back Office Operations Bot Solution",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Dify Autofill"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://your-dify-endpoint.example.com/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background/index.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/domExclusionRegistry.js",
        "content/domExclusionDefaults.js",
        "content/labelResolver.js",
        "content/cssPathBuilder.js",
        "content/domSnapshotCollector.js",
        "content/elementValueSetter.js",
        "content/fieldValueApplier.js",
        "sites/olx/prefillService.js",
        "sites/allegrolokalnie/prefillService.js",
        "content/messageRouter.js",
        "contentScript.js"
      ],
      "run_at": "document_idle"
    }
  ]
}

